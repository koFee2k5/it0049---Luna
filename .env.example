CI_ENVIRONMENT = development

app.baseURL = 'http://127.0.0.1:8080/'
# Render can use APP_BASE_URL=https://your-service.onrender.com/

database.default.hostname = localhost
database.default.database = basic_pos
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# Aiven / Render SSL settings. Put the complete downloaded Aiven CA PEM in
# DB_SSL_CA, or use DB_SSL_CA_PATH for a local certificate file.
# DB_HOST = mysql-xxxx.aivencloud.com
# DB_NAME = defaultdb
# DB_USER = avnadmin
# DB_PASSWORD = your-aiven-password
# DB_PORT = 12345
# DB_SSL_CA =
# DB_SSL_VERIFY = true
# DB_ENCRYPT = {"ssl_verify":false}
